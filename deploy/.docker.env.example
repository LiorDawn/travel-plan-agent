# Docker 部署环境变量模板（复制为 .docker.env 后填入真实口令，勿提交 .docker.env）
# 用法: docker compose --env-file .docker.env up -d

# Agent 数据库连接串（含口令）
AGENT_DATABASE_URL=postgresql+asyncpg://agent:change-me@postgres:5432/agent_db

# ERP 数据库
ERP_DB_USER=erp
ERP_DB_PASSWORD=change-me

# PostgreSQL 超级用户
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me