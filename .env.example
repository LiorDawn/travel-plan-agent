# ==================== 应用配置 ====================
APP_NAME=travel_plan_agent
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# Agent checkpointer: memory | redis（redis 需安装 langgraph-checkpoint-redis）
CHECKPOINTER=memory

# ==================== 数据库 ====================
DATABASE_URL=postgresql+asyncpg://agent:agent123@localhost:5432/agent_db
DATABASE_URL_SYNC=postgresql://agent:agent123@localhost:5432/agent_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ==================== LLM ====================
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Embedding 模型
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ==================== RAG 过程缓存（v3.0 降成本） ====================
# LLM 改写关键词结果缓存（秒）
RAG_REWRITE_CACHE_ENABLED=true
RAG_REWRITE_CACHE_TTL=600
# embedding 向量缓存（秒，向量复用度高、可长）
RAG_EMBED_CACHE_ENABLED=true
RAG_EMBED_CACHE_TTL=86400
# 子图内首检后会话级复用注入内容，避免每步重复检索
RAG_SESSION_INJECT=true

# ==================== Token 统计（v3.0 落 Redis） ====================
# 进程内存兜底标记；true 时用 Redis HINCRBY 按意图/会话/日期累计（Redis 不可用自动降级进程内存）
TOKEN_STATS_REDIS_ENABLED=true
TOKEN_STATS_TTL=604800

# ==================== Java ERP ====================
ERP_BASE_URL=http://localhost:8080
ERP_API_KEY=your-erp-api-key
ERP_TIMEOUT=10

# ==================== MCP ====================
MCP_FLIGHT_SERVER_URL=
MCP_HOTEL_SERVER_URL=
MCP_WEATHER_BASE_URL=http://localhost:8100

# ==================== 安全 ====================
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ==================== 速率限制 ====================
RATE_LIMIT_CHAT=30
RATE_LIMIT_WINDOW=60

# ==================== API 管理令牌（最小防线） ====================
# 保护 /audits、/monitor 等敏感端点。空 = 关闭鉴权（本地演示）；生产必填非空
API_ADMIN_TOKEN=
# CORS 白名单，逗号分隔。空 = 允许任意来源但禁用 credentials（本地演示）；生产填精确域名
CORS_ORIGINS=
